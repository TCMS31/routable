# Copy to .env and fill in. `.env` is git-ignored and must never be committed.
#
# The values that used to live here were real-looking OAuth client secrets for
# QuickBooks and Xero. They have been removed; if you are the owner of those
# apps, rotate the credentials in the respective developer portals.

# --- Django ---------------------------------------------------------------
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_LOG_LEVEL=INFO

# --- Ledger ---------------------------------------------------------------
LEDGER_DEFAULT_PROVIDER=quickbooks
LEDGER_HTTP_TIMEOUT=15

# --- QuickBooks Online ----------------------------------------------------
# https://developer.intuit.com/app/developer/appdetail  ->  Keys & credentials
QBOOK_CLIENT_ID=
QBOOK_CLIENT_SECRET=
QBOOK_REDIRECT_URI=http://localhost:8870/accounts/quickbooks/login/callback/
QBOOK_ENVIRONMENT=sandbox
# Optional: the realm id is captured automatically from the OAuth callback.
QBOOK_COMPANY_ID=

# --- Xero -----------------------------------------------------------------
# https://developer.xero.com/app/manage
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:8870/ledger/xero/callback/
# Optional: the tenant id is read from /connections after authorisation.
XERO_TENANT_ID=
